{
  "name": "dsh-theme",
  "version": "1.0.0",
  "description": "30-theme pack for the DeepSeek Harness web UI — a zero-dependency DSH client plugin plus drop-in CSS themes.",
  "author": "mux9056-bot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mux9056-bot/dsh-theme.git"
  },
  "bugs": {
    "url": "https://github.com/mux9056-bot/dsh-theme/issues"
  },
  "homepage": "https://github.com/mux9056-bot/dsh-theme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": ["slots"],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib",
    "themes",
    "preview.html",
    "scripts",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/build.mjs --verify-only",
    "verify:live": "node scripts/build.mjs --verify-only --live",
    "install:local": "node scripts/install.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "theme",
    "plugin",
    "cordis"
  ],
  "license": "Apache-2.0"
}
